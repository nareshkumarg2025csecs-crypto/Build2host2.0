# built2host environment variables
# Base site URL (e.g. https://built2host.in or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Firebase Client SDK (used exclusively on /admin/login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side Firestore & session management)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin Panel Authorization
# Comma-separated list of permitted emails
ADMIN_EMAILS=
# Role mappings: email:owner,email:websites,email:automation (defaults to owner if not specified)
ADMIN_ROLES=

# Gmail SMTP Transport
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=

# Salt for SHA-256 IP hashing (never store raw visitor IPs)
IP_HASH_SALT=
